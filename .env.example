# TripTalk Agent Configuration

# ============================================
# LLM Configuration (required)
# ============================================

# LLM Provider: "anthropic" (default) or "openai"
LLM_PROVIDER=anthropic

# Anthropic (default)
ANTHROPIC_API_KEY=your-anthropic-api-key-here
# ANTHROPIC_MODEL=claude-sonnet-4-20250514

# OpenAI (alternative)
# OPENAI_API_KEY=your-openai-api-key-here
# OPENAI_MODEL=gpt-4o

# ============================================
# Turso Database (required)
# ============================================

# Get these from: turso db show <db-name> --url / turso db tokens create <db-name>
TURSO_DATABASE_URL=libsql://your-db-name-your-org.turso.io
TURSO_AUTH_TOKEN=your-turso-auth-token-here

# ============================================
# App Configuration (optional)
# ============================================

# Rate limiting
# RATE_LIMIT_MAX=30          # Max requests per window
# RATE_LIMIT_WINDOW_MS=60000 # Window in milliseconds

# Message limits
# MAX_MESSAGE_LENGTH=2000    # Max characters per message
# MAX_MESSAGES_PER_TRIP=200  # Max messages per trip conversation

# ============================================
# Docker Configuration
# ============================================
# PORT=3000
